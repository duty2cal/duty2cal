# SPDX-License-Identifier: MPL-2.0
# The required elements of the two legal notices, in one place. Both
# scripts/check-site-content.sh (the assembled output) and
# scripts/legal-notices-check.sh (the source carriers) source this file, so a
# wording or policy revision edits one file.
#
# Values are matched literally. A line asserts that the page carries the text,
# never that the text is legally sufficient.

# The notice pages' own content security policy: no script at all, no
# connection anywhere, no form. A notice page that needs a script is a defect.
NOTICE_CSP="default-src 'self'; script-src 'none'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"

# Both notices: the document and summary languages, and the binding sentence.
NOTICE_DOCUMENT_LANG='lang="de"'
NOTICE_SUMMARY_LANG='lang="en"'
NOTICE_SUMMARY_BINDING='The German version is the legally binding one.'

# The Impressum's required elements.
IMP_NAME='Daniel Kressner'
IMP_SERVICE_ADDRESS='Zustellanschrift'
IMP_EMPLOYER_ROLE='nicht Anbieter dieses Projekts'
IMP_NON_AFFILIATION='keine Verbindung zu Lufthansa, Jeppesen'
IMP_TRADEMARK='Marken gehören ihren jeweiligen Inhabern'
IMP_LICENCE='MPL-2.0'
IMP_AS_IS='ohne Gewähr'
IMP_SOURCE='github.com/duty2cal/duty2cal'

# The Datenschutzerklärung's required elements.
PRIV_CONTROLLER='Verantwortlicher'
PRIV_HOST='GitHub, Inc.'
PRIV_IP='IP-Adresse'
PRIV_PURPOSE='Sicherheitszwecken'
PRIV_FURTHER_DATA='Zeitpunkt der Anfrage'
PRIV_BASIS='Art. 6 Abs. 1 lit. f DSGVO'
PRIV_TRANSFER='Data Privacy Framework'
PRIV_SCC='Standardvertragsklauseln'
PRIV_SUBPROCESSORS='Unterauftragsverarbeiter'
PRIV_RETENTION='Speicherdauer'
PRIV_LOCAL_PROCESSING='ausschließlich in Ihrem Browser'
PRIV_COOKIES='keine Cookies'
PRIV_RIGHTS='Aufsichtsbehörde'
PRIV_MAIL_PROVIDER='SimpleLogin'
PRIV_STANDING_DATE='Stand:'

# A marker in any of these strings is a placeholder or a withdrawn element and
# refuses the page set. The last one is the discontinued EU online
# dispute-resolution platform; a live reference to it is a warning risk.
NOTICE_FORBIDDEN=(
  'TODO'
  'Mustermann'
  'example.org'
  'ec.europa.eu/consumers/odr'
)

# The two carriers outside the Site output, and the labelled links each holds.
CARRIER_PROFILE='org/profile/README.md'
CARRIER_README='README.md'
NOTICE_LINK_IMPRESSUM='[Impressum](https://duty2cal.github.io/impressum)'
NOTICE_LINK_PRIVACY='[Datenschutz](https://duty2cal.github.io/privacy)'
