# The one support statement, sourced by scripts/support-statement-check.sh and
# scripts/check-site-content.sh. A wording revision edits this file once.
SUPPORT_PROJECT='duty2cal converts a Lufthansa cabin-crew duty plan published as a Jeppesen PDF export into one calendar file.'
SUPPORT_SITE='This tool converts a Lufthansa cabin-crew duty plan published as a Jeppesen PDF export into one calendar file.'
BOUNDARY='One roster month of cabin crew; not cockpit duties, other Lufthansa duty plans, other Jeppesen exports or another operator.'
NON_AFFILIATION='Not affiliated with Lufthansa, Jeppesen, or any duty-plan provider or airline.'
SUPPORT_SHRUNK='duty2cal does not currently convert a Lufthansa cabin-crew duty plan published as a Jeppesen PDF export; the refusal names the fact or code it could not read.'
SUPPORT_SITE_SHRUNK='This tool does not currently convert a Lufthansa cabin-crew duty plan published as a Jeppesen PDF export; the refusal names the fact or code it could not read.'
