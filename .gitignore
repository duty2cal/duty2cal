private

# Real duty plans never enter the repository (carried over from the first draft)
*_real*.pdf
*_original*.pdf
.pii-denylist

# Rust build output
/target
__pycache__/
*.pyc

# OpenTofu: the declaration's machine-local cache and the adoption's staging
# workspace. The applied state files under infra/ are intentionally tracked:
# they are encrypted at rest (ADR-0006), so no *.tfstate rule exists here.
infra/.terraform/
infra/.adoption-staging/

# givn:begin:rules
.opencode/skills/givn-*/
.agents/skills/givn-*/
.claude/skills/givn-*/
.omp/skills/givn-*/
.opencode/commands/givn-*.md
.opencode/commands/grill-*.md
.omp/commands/givn-*.md
.omp/commands/grill-*.md
.opencode/plugins/givn-attribution.js
.claude/hooks/givn-attribution.sh
.claude/settings.local.json
.omp/hooks/pre/givn-attribution.js
.githooks/commit-msg
# givn:end:rules

# Transient OpenTofu plan files: encrypted, never committed
infra/plan.bin
infra/*.tfplan

# A partial apply's stale marker: refuses the preview and the apply until a
# green apply removes it; never committed
infra/terraform.tfstate.stale
